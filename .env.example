# Copy to .env and adjust
PORT=5184
WA_NUMBER=27672961272
ADMIN_CODE=change-me-strong-passcode
# DATA_DIR=./data

# ── WhatsApp live bridge (lharries/whatsapp-mcp) ──
# URL of the Go bridge's REST API + path to its message store (SQLite).
# When authenticated, bookings auto-send stage-1 availability and the
# reply-polling loop detects staff YES/NO to auto-send stage-2 details.
WA_BRIDGE_URL=http://localhost:8080
WA_BRIDGE_DB=/home/yassin/whatsapp-bridge-live/whatsapp-bridge/store/messages.db

# ── Autonomous lifecycle (hours) ──
# AVAIL_NUDGE_HOURS=24   wait this long for a YES/NO reply before nudging
# AVAIL_MAX_NUDGES=2     max availability follow-ups per booking
# TS_NUDGE_HOURS=24      wait this long after the event for the timesheet
# TS_MAX_NUDGES=3        max timesheet follow-ups per booking
# LIFECYCLE_POLL_MS=60000  how often the autonomous loop checks deadlines
# PUBLIC_URL=             public base URL for the admin link in office summaries
